# ── 로컬 환경 ─────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.DS_Store
.env

# ── 재생성 가능한 대용량 산출물 ───────────────────────────────────────────
# Chroma 인덱스(28MB 단일 sqlite 바이너리)는 커밋하지 않는다 —
# data/embed/places.json + `python -m scripts.run_ingest` 로 언제든 복원되고,
# 바이너리라 재인제스트마다 히스토리에 28MB가 통째로 쌓인다.
# 배포 이미지에는 .dockerignore 에서 제외하지 않아 그대로 들어간다.
data/chroma/
data/embed/*.bak

# ── 작업 기록·실험 산출물 (배포·재현에 불필요) ────────────────────────────
visitseouldocs.json

# markdown 문서·작업 기록 (저장소에 두지 않는다)
AGENTS.md
conversation.md

data/chroma_backup_*/
