# ============================================================
# lewisai 환경설정 — 복사해서 .env 로 쓰세요 (cp .env.example .env)
# ============================================================

# --- 업스테이지 솔라 (챗 LLM — 현행 프로바이더) ---
UPSTAGE_API_KEY=
# Solar Open 2 Private Beta (Stage 1: 2026-07-17 ~ 07-31, 400 RPM / 150K TPM)
UPSTAGE_MODEL=solar-open2
UPSTAGE_BASE_URL=https://api.upstage.ai/v1
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2500

# --- 제미나이 --- (챗 LLM 은 솔라로 전환. 임베딩에는 계속 쓰므로 키는 필요)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- 클로드 폴백 --- (솔라 전환으로 비활성)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
LLM_FALLBACK_ENABLED=true

# --- Visit Seoul API (키 없으면 Mock 데이터로 동작) ---
VISITSEOUL_API_KEY=

# --- 임베딩 (제미나이 네이티브 임베딩) ---
EMBEDDING_MODEL=models/gemini-embedding-001

# --- 벡터 DB (Chroma persist 디렉터리 = sqlite 포함) ---
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=seoullo

# --- 서울 열린데이터 (실시간 혼잡도/행사) ---
SEOUL_API_KEY=

# --- 데이터 경로 ---
PLACES_JSON=./data/raw/seoul_places.json
COURSES_JSON=./data/raw/theme_courses.json
