# ============================================================
# lewisai 환경설정 — 복사해서 .env 로 쓰세요 (cp .env.example .env)
# ============================================================

# --- 제미나이 (LLM) ---
GOOGLE_API_KEY=           
GEMINI_MODEL=gemini-3.1-flash-lite
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2500

# --- 클로드 폴백 (제미나이 쿼터 소진/429 시 자동 전환) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
# 품질 우선이면 claude-sonnet-4-6 / claude-sonnet-5 로 교체
LLM_FALLBACK_ENABLED=true

# --- Visit Seoul API (키 없으면 Mock 데이터로 동작) ---
VISITSEOUL_API_KEY=

# --- 임베딩 (제미나이 네이티브 임베딩) ---
EMBEDDING_MODEL=models/gemini-embedding-001

# --- 벡터 DB (Chroma persist 디렉터리 = sqlite 포함) ---
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=seoullo

# --- 서울 열린데이터 (실시간 혼잡도/행사) ---
SEOUL_API_KEY=

# --- 데이터 경로 ---
PLACES_JSON=./data/raw/seoul_places.json
COURSES_JSON=./data/raw/theme_courses.json
