# ============================================================
# lewisai 환경설정 — 복사해서 .env 로 쓰세요 (cp .env.example .env)
# ============================================================

# --- LLM 공급자 선택: nim | openai | gemini | local ---
LLM_PROVIDER=nim

# OpenAI 호환 엔드포인트 (nim / local 공통)
#  - NVIDIA NIM 클라우드: https://integrate.api.nvidia.com/v1
#  - 로컬(vLLM/Ollama 등): http://localhost:8000/v1
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=           # ← 직접 입력. (절대 코드에 하드코딩 금지)
LLM_MODEL=z-ai/glm-5.1
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2500

# --- Gemini 네이티브를 쓸 때만 (LLM_PROVIDER=gemini) ---
GOOGLE_API_KEY=           # ← 직접 입력. (절대 코드/예시 파일에 하드코딩 금지)
GEMINI_MODEL=gemini-3.1-flash-lite

# --- 임베딩 (제미나이 임베딩 모델) ---
EMBEDDING_MODEL=gemini-embedding-001

# --- 벡터 DB (Chroma persist 디렉터리 = sqlite 포함) ---
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=seoullo

# --- 서울 열린데이터 (실시간 혼잡도/행사) ---
SEOUL_API_KEY=

# --- 데이터 경로 ---
PLACES_JSON=./data/raw/seoul_places.json
COURSES_JSON=./data/raw/theme_courses.json
