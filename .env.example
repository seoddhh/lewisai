# ============================================================
# lewisai 환경설정 — 복사해서 .env 로 쓰세요 (cp .env.example .env)
# ============================================================

# --- 챗 LLM 프로바이더 (upstage | gemini) ---
# 솔라 베타 종료·크레딧 소진 시 이 값만 gemini 로 바꾸면 코드 수정 없이 전환된다.
LLM_PROVIDER=gemini

# --- 업스테이지 솔라 (챗 LLM — 현행 프로바이더) ---
UPSTAGE_API_KEY=
# Solar Open 2 Private Beta (Stage 1: 2026-07-17 ~ 07-31, 400 RPM / 150K TPM)
UPSTAGE_MODEL=solar-open2
UPSTAGE_BASE_URL=https://api.upstage.ai/v1
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4000

# --- 제미나이 --- (챗 LLM 은 솔라로 전환. 임베딩에는 계속 쓰므로 키는 필요)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- 클로드 --- (평가 arm C. LLM_PROVIDER=claude 로 두면 앱 전체가 이 모델로 돈다)
# 입력 $1 / 출력 $5 per MTok · 200K 컨텍스트 — 솔라·제미나이와 같은 빠른/저가 티어
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# --- Visit Seoul API (키 없으면 Mock 데이터로 동작) ---
VISITSEOUL_API_KEY=


# --- 임베딩 프로바이더 (upstage | ollama) --- 챗 LLM 과는 완전히 별개다
# GPU 상시 서빙 비용 때문에 로컬 모델(ollama) 대신 API 호출 구조로 간다.
# 컨테이너 안엔 ollama 가 없으므로 배포에서는 반드시 upstage 여야 한다.
EMBEDDING_PROVIDER=upstage

# upstage 경로 — 솔라 임베딩 2세대. 2,000 RPM / 700,000 TPM, 하루 한도 없음.
# 검색어/문서를 다른 모델로 부르는 비대칭 임베딩이라 접미사(-query/-passage)는 코드가 붙인다.
UPSTAGE_EMBEDDING_MODEL=embedding-2

# ollama 경로 — 로컬 실행, 쿼터 없음. 미리 `ollama pull` 해두어야 한다(로컬 전용).
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:8b
OLLAMA_BASE_URL=http://localhost:11434

# --- 벡터 DB (Chroma persist 디렉터리 = sqlite 포함) ---
# 임베딩 모델과 컬렉션은 1:1 이다. 모델을 바꿨으면 컬렉션 이름도 반드시 바꿀 것.
# 현행: embedding-2 → seoulro_v3 (1648건·1024차원)
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=seoulro_v3

# --- 내부 인증 (BFF ↔ AI 서버 공유 시크릿) ---
# strangemap BFF 와 동일한 값을 공유. 비우면 로컬 개발은 토큰 없이 통과.
# 프로덕션에서만 채우고, 개발자만 아는 값으로 둔다 (git·클라이언트 노출 금지).
AI_SERVER_TOKEN=

# --- 서울 열린데이터 (실시간 혼잡도/행사) ---
SEOUL_API_KEY=

# --- 데이터 경로 ---
PLACES_JSON=./data/embed/places.json
